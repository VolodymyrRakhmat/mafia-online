rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    // Усі записи йдуть через Cloud Functions; клієнт лише читає.
    match /rooms/{r} {
      allow read: if request.auth != null;
      match /players/{u} { allow read: if request.auth != null; }
      match /private/{u} { allow read: if request.auth != null && request.auth.uid == u; }
      match /chat/{m} {
        allow read: if request.auth != null
          && exists(/databases/$(db)/documents/rooms/$(r)/players/$(request.auth.uid));
      }
    }
    match /users/{u} { allow read: if request.auth != null && request.auth.uid == u; }
  }
}
